(ns ime-core.lru-cache)

;; Maximum cache entries, can be adjusted based on actual memory
(defonce max-cache-size 1000)

;; LRU cache structure: {:map {key candidates}, :order [key1 key2 ...]}
(defonce lru-cache (atom {:map {} :order []}))

(defn cache-key
  "Namespaces cache keys so local/remote/next-word results cannot collide."
  [ns key]
  (str ns ":" key))

(defn- touch-order [order key]
  (conj (vec (remove #(= % key) order)) key))

(defn lru-get
  "Returns the cached value (including an empty vector) or nil on miss.
   Updates recency atomically with the lookup."
  [key]
  (let [hit? (volatile! false)
        found (volatile! nil)]
    (swap! lru-cache
           (fn [{:keys [map order] :as cache}]
             (if (contains? map key)
               (do
                 (vreset! hit? true)
                 (vreset! found (get map key))
                 {:map map :order (touch-order order key)})
               cache)))
    (when @hit? @found)))

(defn lru-put [key value]
  (swap! lru-cache
         (fn [{:keys [map order]}]
           (let [new-map (assoc map key value)
                 new-order (touch-order order key)]
             (if (> (count new-order) max-cache-size)
               (let [oldest (first new-order)]
                 {:map (dissoc new-map oldest)
                  :order (vec (rest new-order))})
               {:map new-map :order new-order})))))

(defn clear-cache []
  (reset! lru-cache {:map {} :order []}))
