(ns ime-core.asset-loader
  (:require
   ["dart:io" :as io]
   ["dart:async" :as async]
   ["dart:convert" :as convert]
   ["package:flutter/services.dart" :refer [rootBundle]]
   ["package:archive/archive.dart" :as archive]
   ["package:path_provider/path_provider.dart" :as path-provider]
   [clojure.string :as str]))

(def ^:private cache-format-version 2)

(defn- ^:async get-cache-file-path [asset-path]
  (let [cache-dir (await (path-provider/getApplicationCacheDirectory))
        cache-file-name (str (str/replace asset-path "/" "_")
                             ".v" cache-format-version
                             ".json")
        cache-file (io/File (str (.-path cache-dir) "/" cache-file-name))]
    cache-file))

(defn- ^:async load-from-cache [^io/File cache-file]
  (try
    (when (await (.exists cache-file))
      (let [content-string (await (.readAsString cache-file))]
        (convert/jsonDecode content-string)))
    (catch Exception e
      (dart:core/print (str "[asset-loader] Error reading cache: " e))
      nil)))

(defn- ^:async save-to-cache [^io/File cache-file content]
  (try
    (await (.writeAsString cache-file (convert/jsonEncode content)))
    (catch Exception e
      (dart:core/print (str "[asset-loader] Error saving cache: " e)))))

(defn- archive-json-file [ar]
  (or (first (filter (fn [f]
                       (and (.-isFile f)
                            (str/ends-with? (str/lower-case (.-name f)) ".json")))
                     ar))
      (first (filter #(.-isFile %) ar))))

(defn- bytes-from-byte-data [byte-data]
  (.asUint8List (.-buffer byte-data)
                (.-offsetInBytes byte-data)
                (.-lengthInBytes byte-data)))

(defn ^:async read-json-from-asset-zip [asset-atom asset-path]
  (let [cache-file (await (get-cache-file-path asset-path))
        cached-content (await (load-from-cache cache-file))]
    (if cached-content
      (reset! asset-atom cached-content)
      (let [byte-data (await (.load rootBundle asset-path))
            bytes (bytes-from-byte-data byte-data)
            ar (.decodeBytes (archive/ZipDecoder.) bytes)
            target-file (archive-json-file ar)]
        (if-not target-file
          (throw (Exception. (str "JSON file not found in zip: " asset-path)))
          (let [content (.-content target-file)
                content-string (convert/utf8.decode content)
                parsed-content (convert/jsonDecode content-string)]
            (reset! asset-atom parsed-content)
            (await (save-to-cache cache-file parsed-content))
            parsed-content))))))

(defn ^:async load-assets-parallel
  "Loads multiple ZIP asset files in parallel to improve startup speed.
   asset-configs receives a Vector of [asset-atom asset-path] pairs.
   Example: [[!next-dict \"assets/next.zip\"]]"
  [asset-configs]
  (let [futures (mapv (fn [[asset-atom asset-path]]
                        (read-json-from-asset-zip asset-atom asset-path))
                      asset-configs)]
    (await (async/Future.wait futures))))
