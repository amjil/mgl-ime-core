(ns ime-core.remote-api
  (:require
   ["package:http/http.dart" :as http]
   ["dart:convert" :as convert]
   [clojure.string :as str]
   [ime-core.lru-cache :as lru]))

(def ^:private request-timeout-ms 8000)

;; Global configuration, injected by the main program at initialization.
(defonce !config
  (atom {:base-url ""
         :candidate-api-path ""
         :next-word-api-path ""}))

(defn set-config! [config-map]
  (swap! !config merge config-map))

(defn- build-uri [api-path-key]
  (let [{:keys [base-url] :as cfg} @!config
        api-path (get cfg api-path-key "")]
    (if (str/starts-with? base-url "http")
      (dart:core/Uri.parse
       (str (str/replace base-url #"/+$" "")
            "/"
            (str/replace api-path #"^/+" "")))
      (dart:core/Uri.http base-url (str/replace api-path #"^/+" "")))))

(defn ^:async post-word-json [uri key]
  (await
   (-> (http/post
        uri
        .headers {"Content-Type" "application/json; charset=UTF-8"}
        .body (convert/jsonEncode {"word" key}))
       (.timeout (dart:core/Duration .milliseconds request-timeout-ms)))))

(defn- item-text [item]
  (if (string? item)
    item
    (when item
      (let [x (first item)]
        (when (string? x) x)))))

(defn parse-string-list
  "Decodes a JSON object and returns the named field as a vector of strings."
  [body field-name]
  (try
    (let [decoded (convert/jsonDecode body)
          raw (get decoded field-name)]
      (if (nil? raw)
        []
        (->> raw
             (map item-text)
             (filter #(and (string? %) (not (str/blank? %))))
             vec)))
    (catch Exception _
      [])))

(defn- ^:async fetch-word-list [cache-ns api-path-key field-name key]
  (if (str/blank? key)
    []
    (let [ck (lru/cache-key cache-ns key)
          cached (lru/lru-get ck)]
      (if (some? cached)
        cached
        (try
          (let [uri (build-uri api-path-key)
                result (await (post-word-json uri key))
                status (.-statusCode result)]
            (if (= status 200)
              (let [words (parse-string-list (.-body result) field-name)]
                (lru/lru-put ck words)
                words)
              []))
          (catch Exception e
            (dart:core/print (str "[remote-api] request error: " e))
            []))))))

(defn ^:async get-candidates-remote [key]
  (await (fetch-word-list "remote" :candidate-api-path "candidates" key)))

(defn ^:async get-next-words-remote [key]
  (await (fetch-word-list "next" :next-word-api-path "nextWords" key)))
